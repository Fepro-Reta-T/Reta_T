# Copiar este archivo a .env y completar valores reales.
# .env NUNCA se commitea (ya está en .gitignore).

# --- PostgreSQL (contenedor db) ---
POSTGRES_USER=reta_t
POSTGRES_PASSWORD=changeme
POSTGRES_DB=reta_t
POSTGRES_PORT=5432

# --- Backend (contenedor api) ---
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://reta_t:changeme@db:5432/reta_t
ENVIRONMENT=development

# Clave para firmar los JWT — generar una propia con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Nunca usar este valor de ejemplo en un ambiente real.
JWT_SECRET_KEY=changeme-generar-una-clave-real-de-32-bytes
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Orígenes permitidos por CORS — las apps de frontend, que corren fuera de Docker vía pnpm
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
