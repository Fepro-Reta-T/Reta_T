from uuid import UUID

from sqlalchemy import select
from sqlalchemy.ext.asyncio import AsyncSession
from sqlalchemy.orm import selectinload

# Ajusta este import a donde realmente vivan tus clases Equipo y Tournament
# (por lo que compartiste, ambas están en el mismo archivo, ej. models/equipo.py)
from app.models.equipo import Equipo, Tournament


class InscripcionRepository:
    def __init__(self, db: AsyncSession):
        self.db = db

    async def _obtener_torneo_con_equipos(self, torneo_id: UUID) -> Tournament | None:
        resultado = await self.db.execute(
            select(Tournament)
            .options(selectinload(Tournament.equipos))
            .where(Tournament.id == torneo_id)
        )
        return resultado.scalar_one_or_none()

    async def _obtener_equipo(self, equipo_id: UUID) -> Equipo | None:
        resultado = await self.db.execute(select(Equipo).where(Equipo.id == equipo_id))
        return resultado.scalar_one_or_none()

    async def listar_equipos_inscritos(self, torneo_id: UUID) -> list[Equipo] | None:
        """None significa 'torneo no encontrado' — el router decide si es 404."""
        torneo = await self._obtener_torneo_con_equipos(torneo_id)
        if torneo is None:
            return None
        return torneo.equipos

    async def inscribir(self, torneo_id: UUID, equipo_id: UUID) -> Tournament | None:
        torneo = await self._obtener_torneo_con_equipos(torneo_id)
        equipo = await self._obtener_equipo(equipo_id)
        if torneo is None or equipo is None:
            return None
        if equipo not in torneo.equipos:
            torneo.equipos.append(equipo)
            await self.db.commit()
        return torneo

    async def retirar(self, torneo_id: UUID, equipo_id: UUID) -> bool:
        torneo = await self._obtener_torneo_con_equipos(torneo_id)
        equipo = await self._obtener_equipo(equipo_id)
        if torneo is None or equipo is None:
            return False
        if equipo in torneo.equipos:
            torneo.equipos.remove(equipo)
            await self.db.commit()
        return True
